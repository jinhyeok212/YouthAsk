{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Experiment Result",
  "type": "object",
  "required": [
    "experiment_id",
    "status",
    "index_reused",
    "metrics_summary"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "PARTIAL_SUCCESS"
      ]
    },
    "index_reused": {
      "type": "boolean"
    },
    "metrics_summary": {
      "type": "object",
      "required": [
        "document_mrr",
        "chunk_mrr",
        "average_retrieval_latency_ms",
        "p95_retrieval_latency_ms",
        "retrieval_failure_count",
        "evaluation_query_count",
        "evaluation_ks"
      ],
      "properties": {
        "document_mrr": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "chunk_mrr": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "average_retrieval_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "p95_retrieval_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "retrieval_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "evaluation_query_count": {
          "type": "integer",
          "minimum": 1
        },
        "evaluation_ks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "patternProperties": {
        "^(document|chunk)_hit_at_[0-9]+$": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
