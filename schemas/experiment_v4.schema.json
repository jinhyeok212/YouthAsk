{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Experiment Config",
  "type": "object",
  "required": [
    "experiment_id",
    "schema_version",
    "dataset",
    "chunking",
    "evaluation",
    "embedding",
    "index",
    "retrieval"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_name": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "base_experiment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "dataset": {
      "type": "object",
      "required": [
        "version",
        "preprocessing_version",
        "document_path",
        "manifest_path"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "preprocessing_version": {
          "type": "string",
          "minLength": 1
        },
        "document_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "chunking": {
      "type": "object",
      "required": [
        "version",
        "strategy",
        "size",
        "overlap",
        "unit",
        "target_field",
        "chunk_path",
        "manifest_path"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "string",
          "enum": [
            "section"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "overlap": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "characters"
          ]
        },
        "target_field": {
          "type": "string",
          "minLength": 1
        },
        "chunk_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluation": {
      "type": "object",
      "required": [
        "version",
        "questions_path",
        "document_qrels_path",
        "chunk_qrels_path"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "questions_path": {
          "type": "string",
          "minLength": 1
        },
        "document_qrels_path": {
          "type": "string",
          "minLength": 1
        },
        "chunk_qrels_path": {
          "type": "string",
          "minLength": 1
        },
        "ks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "embedding": {
      "type": "object",
      "required": [
        "model",
        "dimension",
        "normalize",
        "batch_size",
        "device"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "normalize": {
          "type": "boolean"
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "device": {
          "type": "string",
          "enum": [
            "auto",
            "cuda",
            "cpu",
            "mps"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "index": {
      "type": "object",
      "required": [
        "version",
        "db_path",
        "collection_name",
        "distance_metric"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "db_path": {
          "type": "string",
          "minLength": 1
        },
        "collection_name": {
          "type": "string",
          "minLength": 1
        },
        "distance_metric": {
          "type": "string",
          "enum": [
            "cosine",
            "l2",
            "ip"
          ]
        },
        "db_batch_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "retrieval": {
      "type": "object",
      "required": [
        "evaluation_max_k",
        "context_top_k"
      ],
      "properties": {
        "evaluation_max_k": {
          "type": "integer",
          "minimum": 1
        },
        "context_top_k": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "retrieval_error_policy": {
          "type": "string",
          "enum": [
            "partial",
            "fail"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
